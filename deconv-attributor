#!/usr/bin/env bash
set -euo pipefail
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export PYTHONPATH="${ROOT_DIR}/src:${PYTHONPATH:-}"
if [ -x "${ROOT_DIR}/.venv/bin/python3" ]; then
    PYTHON_BIN="${ROOT_DIR}/.venv/bin/python3"
else
    PYTHON_BIN="python3"
fi
exec "${PYTHON_BIN}" -m deconv_attributor.cli "$@"
